+bool ReadPositiveShopMember(Il2CppObject* object, const char* const* names, std::size_t nameCount,
+                            std::int64_t& value, std::wstring& matchedName) {
+    value = 0; matchedName.clear();
+    if (!object) return false;
+    Il2CppClass* klass = g_api.object_get_class(object);
+    if (!klass) return false;
+    for (std::size_t i = 0; i < nameCount; ++i) {
+        std::int64_t candidate = 0;
+        if (ReadScalarMember64(object, klass, names[i], candidate) && candidate > 0) {
+            value = candidate;
+            for (const char* p = names[i]; p && *p; ++p) matchedName.push_back(static_cast<unsigned char>(*p));
+            return true;
+        }
+    }
+    return false;
+}
+
+bool FindCurrentShopContext(std::int64_t& npcShopID, std::int64_t& shopID,
+                            wchar_t* detail, std::size_t cap) {
+    npcShopID = 0; shopID = 0;
+    if (!EnsureUiLua(true, detail, cap)) return false;
+    const char* uiNames[] = {"NPCShop_SellItemTab", "NPCShop", "NPCShop_Main", "NPCShop_BuyItemTab"};
+    const char* npcNames[] = {"NpcShopID", "NPCShopID", "NpcShopId", "NPCShopId", "npcShopID", "npcShopId",
+                              "m_NpcShopID", "m_NPCShopID", "_npcShopID", "_NpcShopID"};
+    const char* shopNames[] = {"ShopID", "ShopId", "shopID", "shopId", "m_ShopID", "_shopID", "_ShopID"};
+    for (const char* uiName : uiNames) {
+        Il2CppObject* ui = nullptr; wchar_t ignored[128]{};
+        if (!FindUiByName(uiName, ui, ignored, _countof(ignored)) || !ui) continue;
+        std::wstring npcField, shopField;
+        const bool gotNpc = ReadPositiveShopMember(ui, npcNames, _countof(npcNames), npcShopID, npcField);
+        const bool gotShop = ReadPositiveShopMember(ui, shopNames, _countof(shopNames), shopID, shopField);
+        if (gotNpc && gotShop) {
+            SetText(detail, cap, L"T1 shop context OK; NpcShopID="); AppendInt64(detail, cap, npcShopID);
+            Append(detail, cap, L"; ShopID="); AppendInt64(detail, cap, shopID);
+            Append(detail, cap, L"; UI=");
+            std::wstring uiWide; for (const char* p = uiName; *p; ++p) uiWide.push_back(static_cast<unsigned char>(*p));
+            Append(detail, cap, uiWide.c_str());
+            return true;
+        }
+        npcShopID = 0; shopID = 0;
+    }
+    SetText(detail, cap, L"T1 cannot read NpcShopID/ShopID from current shop UI; packet not sent");
+    return false;
+}
+
+bool DirectSellTest(std::int64_t instanceID, std::int32_t expectedItemID, Response& response,
+                    wchar_t* detail, std::size_t cap) {
+    Classes c{};
+    if (!ResolveClasses(c, detail, cap) || !SafeForAction(c, detail, cap)) return false;
+    Il2CppObject* itemObject = nullptr; BagItemSnapshot item{};
+    if (!FindFreshBagItem(c, instanceID, expectedItemID, itemObject, item, detail, cap)) return false;
+    std::int64_t npcShopID = 0, shopID = 0;
+    if (!FindCurrentShopContext(npcShopID, shopID, detail, cap)) return false;
+    if (!direct_sell_logic::CanTestSell(item.sellable != 0, item.itemID, npcShopID, shopID)) {
+        if (!item.sellable) SetText(detail, cap, L"T1 blocked: IsItemSellable=false");
+        else if (direct_sell_logic::IsQuestFamily(item.itemID)) SetText(detail, cap, L"T1 blocked: quest-family item");
+        else SetText(detail, cap, L"T1 blocked: invalid shop context");
+        return false;
+    }
+    const std::string payload = direct_sell_logic::BuildPayload(item.instanceID, npcShopID, shopID);
+    if (!SendNetworkPacket(c, 200036, payload, detail, cap)) return false;
+    response.resultCode = static_cast<std::int32_t>(ActionResult::ActionInvoked);
+    response.value64_0 = item.instanceID;
+    response.value0 = static_cast<std::int32_t>(npcShopID);
+    response.value1 = static_cast<std::int32_t>(shopID);
+    SetText(detail, cap, L"T1 SEND 200036 OK; instance="); AppendInt64(detail, cap, item.instanceID);
+    Append(detail, cap, L"; NpcShopID="); AppendInt64(detail, cap, npcShopID);
+    Append(detail, cap, L"; ShopID="); AppendInt64(detail, cap, shopID);
+    return true;
+}
