+
+bool BelongsToCurrentShop(Il2CppObject* candidate, Il2CppObject* npcShop) {
+    if (!candidate || !npcShop || candidate == npcShop) return false;
+    Il2CppClass* candidateClass = g_api.object_get_class(candidate);
+    if (!candidateClass) return false;
+
+    Il2CppObject* coreParents = nullptr;
+    if (ObjectGetter(candidate, candidateClass, "get_CoreParents", coreParents) && coreParents) {
+        std::vector<Il2CppObject*> parents;
+        if (ReadManagedPointerArray(coreParents, parents, 64)) {
+            for (Il2CppObject* parent : parents) {
+                if (parent == npcShop) return true;
+            }
+        }
+    }
+
+    std::vector<Il2CppObject*> seen;
+    Il2CppObject* current = candidate;
+    for (int depth = 0; depth < 16 && current; ++depth) {
+        if (std::find(seen.begin(), seen.end(), current) != seen.end()) break;
+        seen.push_back(current);
+        Il2CppClass* currentClass = g_api.object_get_class(current);
+        if (!currentClass) break;
+        Il2CppObject* parent = nullptr;
+        if (!ObjectGetter(current, currentClass, "get_Parent", parent) || !parent) break;
+        if (parent == npcShop) return true;
+        current = parent;
+    }
+    return false;
+}
+
+const MethodInfo* FindUiObjectExecuteMethod(wchar_t* detail, std::size_t cap) {
+    if (!g_ui.executor || !g_ui.uiObject || !g_api.class_get_methods || !g_api.method_get_name) {
+        SetText(detail, cap, L"T1 thiếu metadata method enumeration cho UIObject overload");
+        return nullptr;
+    }
+    const MethodInfo* match = nullptr;
+    for (Il2CppClass* current = g_ui.executor; current; current = g_api.class_get_parent(current)) {
+        void* iterator = nullptr;
+        while (const MethodInfo* method = g_api.class_get_methods(current, &iterator)) {
+            if (!Eq(g_api.method_get_name(method), "ExecuteScriptFunction") ||
+                g_api.method_get_param_count(method) != 3 || StaticMethod(method)) {
+                continue;
+            }
+            const Il2CppType* firstType = g_api.method_get_param(method, 0);
+            Il2CppClass* firstClass = firstType ? g_api.class_from_type(firstType) : nullptr;
+            if (firstClass != g_ui.uiObject || !ParamType(method, 1, "System.String") ||
+                !ParamType(method, 2, "System.Object[]")) {
+                continue;
+            }
+            if (match && match != method) {
+                SetText(detail, cap, L"T1 có nhiều ExecuteScriptFunction(UIObject,...); fail-closed");
+                return nullptr;
+            }
+            match = method;
+        }
+    }
+    if (!match) SetText(detail, cap, L"T1 thiếu ExecuteScriptFunction(UIObject,string,object[])");
+    return match;
+}
+
+bool FindCurrentStockSellRoot(Il2CppObject*& executor, Il2CppObject*& sellTab,
+                              wchar_t* detail, std::size_t cap) {
+    executor = nullptr;
+    sellTab = nullptr;
+    Il2CppObject* npcShop = nullptr;
+    if (!FindUiByName("NPCShop", npcShop, detail, cap) || !npcShop) {
+        SetText(detail, cap, L"T1 blocked: NPCShop is not active; stock request not invoked");
+        return false;
+    }
+    Il2CppClass* npcShopClass = g_api.object_get_class(npcShop);
+    std::int32_t shopActive = 0;
+    if (!npcShopClass ||
+        !ScalarGetter(npcShopClass, "get_ActiveInHierarchy", npcShop, shopActive, detail, cap) ||
+        !shopActive) {
+        SetText(detail, cap, L"T1 blocked: current NPCShop root is inactive");
+        return false;
+    }
+
+    const MethodInfo* getInstance = ExactMethod(g_ui.executor, "get_Instance", 0, true);
+    if (!getInstance || !InvokeObject(getInstance, nullptr, executor, detail, cap) || !executor) {
+        SetText(detail, cap, L"T1 blocked: MonoBehaviourExecutor.Instance is unavailable");
+        return false;
+    }
+    const MethodInfo* findRoots = ExactMethod(
+        g_ui.executor, "FindScriptUIRoots", 1, false, "System.String");
+    if (!findRoots) {
+        SetText(detail, cap, L"T1 blocked: FindScriptUIRoots(string) is unavailable");
+        return false;
+    }
+    Il2CppString* scriptName = g_api.string_new("NPCShop_SellItemTab");
+    if (!scriptName) {
+        SetText(detail, cap, L"T1 cannot create nested sell-script name");
+        return false;
+    }
+    void* findArgs[] = {&scriptName};
+    Il2CppObject* rootsArray = nullptr;
+    if (!InvokeObjectArgs(findRoots, executor, findArgs, rootsArray, detail, cap) || !rootsArray) {
+        SetText(detail, cap, L"T1 blocked: FindScriptUIRoots returned null");
+        return false;
+    }
+    std::vector<Il2CppObject*> roots;
+    if (!ReadManagedPointerArray(rootsArray, roots, 32)) {
+        SetText(detail, cap, L"T1 blocked: nested sell-root array is invalid");
+        return false;
+    }
+
+    std::vector<direct_sell_logic::StockSellRootCandidate> candidates;
+    candidates.reserve(roots.size());
+    for (Il2CppObject* root : roots) {
+        Il2CppClass* rootClass = root ? g_api.object_get_class(root) : nullptr;
+        std::wstring name;
+        std::int32_t active = 0;
+        const bool nameMatches = rootClass && StringGetter(root, rootClass, "get_Name", name) &&
+                                 name == L"SellItemTab";
+        const bool activeInHierarchy = rootClass &&
+            ScalarGetter(rootClass, "get_ActiveInHierarchy", root, active, detail, cap) && active != 0;
+        candidates.push_back({
+            root != nullptr,
+            nameMatches,
+            activeInHierarchy,
+            BelongsToCurrentShop(root, npcShop),
+        });
+    }
+
+    const direct_sell_logic::StockSellRootSelection selection =
+        direct_sell_logic::SelectStockSellRoot(candidates.data(), candidates.size());
+    if (selection.decision != direct_sell_logic::StockSellRootDecision::Unique) {
+        if (selection.decision == direct_sell_logic::StockSellRootDecision::Ambiguous) {
+            SetText(detail, cap, L"T1 blocked: multiple active SellItemTab roots belong to current NPCShop");
+        } else {
+            SetText(detail, cap, L"T1 blocked: no active SellItemTab root belongs to current NPCShop");
+        }
+        Append(detail, cap, L"; discovered roots=");
+        AppendInt(detail, cap, static_cast<int>(roots.size()));
+        return false;
+    }
+    sellTab = roots[selection.index];
+    return true;
+}
+
+bool ExecuteStockSellRequest(Il2CppObject* executor, Il2CppObject* sellTab,
