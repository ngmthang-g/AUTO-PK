     void LogAccount(const Account& a, const std::wstring& line) { Log(L"[" + Tag(a) + L"] " + line); }
+
+    std::wstring ConfirmSection(const Account& a) const {
+        if ((a.snapshot.validMask & ValidIdentity) && a.snapshot.roleID > 0)
+            return L"Confirm.Role." + std::to_wstring(a.snapshot.roleID);
+        const std::wstring base = a.snapshot.characterName[0] ? std::wstring(a.snapshot.characterName) : a.game.title;
+        const std::wstring seed = base + L"#PID" + std::to_wstring(a.game.pid);
+        std::uint64_t hash = 1469598103934665603ull;
+        for (wchar_t ch : seed) {
+            hash ^= static_cast<std::uint16_t>(ch);
+            hash *= 1099511628211ull;
+        }
+        return L"Confirm.Window." + std::to_wstring(hash);
+    }
+
+    void LoadAccountConfirm(Account& a) {
+        const std::wstring section = ConfirmSection(a);
+        ScreenPoint& p = a.periodicConfirm.point;
+        p.x = ReadIniIntSection(section, L"X", -1);
+        p.y = ReadIniIntSection(section, L"Y", -1);
+        p.baseW = ReadIniIntSection(section, L"W", 0);
+        p.baseH = ReadIniIntSection(section, L"H", 0);
+        p.valid = p.x >= 0 && p.y >= 0 && p.baseW > 0 && p.baseH > 0;
+        a.periodicConfirm.intervalSec = std::clamp(ReadIniIntSection(section, L"IntervalSec", 0), 0, 86400);
+    }
+
+    void SaveAccountConfirm(const Account& a) {
+        const std::wstring section = ConfirmSection(a);
+        const ScreenPoint& p = a.periodicConfirm.point;
+        WriteIniIntSection(section, L"X", p.valid ? p.x : -1);
+        WriteIniIntSection(section, L"Y", p.valid ? p.y : -1);
+        WriteIniIntSection(section, L"W", p.valid ? p.baseW : 0);
+        WriteIniIntSection(section, L"H", p.valid ? p.baseH : 0);
+        WriteIniIntSection(section, L"IntervalSec", std::clamp(a.periodicConfirm.intervalSec, 0, 86400));
+        FlushIni();
+    }
+
+    void LoadSelectedConfirmUi() {
+        Account* a = SelectedAccount();
+        if (!a) {
+            SetText(confirmPoint_, L"CHƯA CHỌN ACC");
+            SetText(confirmSeconds_, L"0");
+            return;
+        }
+        SetText(confirmPoint_, PointText(a->periodicConfirm.point));
+        SetText(confirmSeconds_, std::to_wstring(a->periodicConfirm.intervalSec));
+    }
+
+    void SaveSelectedConfirmTime() {
+        Account* a = SelectedAccount();
+        if (!a) { Log(L"XN MAP: chọn một acc trước."); return; }
+        a->periodicConfirm.intervalSec = std::clamp(_wtoi(GetText(confirmSeconds_).c_str()), 0, 86400);
+        SaveAccountConfirm(*a);
+        if (a->runtime.running && settings_.clicks[kSemanticConfirmSlot].enabled && a->periodicConfirm.intervalSec > 0)
+            a->runtime.nextPeriodicConfirmTick = GetTickCount() + static_cast<DWORD>(a->periodicConfirm.intervalSec * 1000u);
+        else
+            a->runtime.nextPeriodicConfirmTick = 0;
+        LoadSelectedConfirmUi();
+        LogAccount(*a, L"Đã lưu XN MAP mỗi " + std::to_wstring(a->periodicConfirm.intervalSec) + L" giây • " + PointText(a->periodicConfirm.point));
+    }
 
