+    bool ClickPeriodicConfirmPoint(Account& a, const std::wstring& reason) {
+        if (!AcquireMouseLease(a, reason)) return false;
+        POINT p{}; std::wstring error;
+        if (!ScaleClickPoint(a.game, a.periodicConfirm.point, p, error)) {
+            LogAccount(a, L"CLICK XÁC NHẬN MAP ACC FAIL: " + error);
+            ReleaseMouseLease(L"click fail");
+            return false;
+        }
+        const bool ok = PerformRealInputClickDirect(a, p, error);
+        if (ok) LogAccount(a, L"REAL CLICK XÁC NHẬN MAP ACC → " + std::to_wstring(p.x) + L"," + std::to_wstring(p.y));
+        else LogAccount(a, L"REAL CLICK XÁC NHẬN MAP ACC FAIL: " + error);
+        ReleaseMouseLease(ok ? L"XN MAP click xong" : L"XN MAP click fail");
+        return ok;
+    }
+
+    bool DrivePeriodicConfirm(Account& a, DWORD now) {
+        if (!settings_.clicks[kSemanticConfirmSlot].enabled) {
+            a.runtime.nextPeriodicConfirmTick = 0;
+            return false;
+        }
+        if (!a.periodicConfirm.point.valid || a.periodicConfirm.intervalSec <= 0) {
+            a.runtime.nextPeriodicConfirmTick = 0;
+            return false;
+        }
+        if (!a.runtime.nextPeriodicConfirmTick) {
+            a.runtime.nextPeriodicConfirmTick = now + static_cast<DWORD>(a.periodicConfirm.intervalSec * 1000u);
+            return false;
+        }
+        if (static_cast<LONG>(now - a.runtime.nextPeriodicConfirmTick) < 0) return false;
+        if (mouseLeasePid_ && mouseLeasePid_ != a.game.pid) return false;
+
+        const bool ok = ClickPeriodicConfirmPoint(a, L"TIMER XN MAP theo ACC");
+        a.runtime.lastConfirmClick = now;
+        a.runtime.nextPeriodicConfirmTick = ok
+            ? now + static_cast<DWORD>(a.periodicConfirm.intervalSec * 1000u)
+            : now + 1000u;
+        if (ok)
+            a.runtime.status = L"TIMER XN MAP click xong • lần sau sau " + std::to_wstring(a.periodicConfirm.intervalSec) + L" giây";
+        return true;
